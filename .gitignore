# ================================================================
# 🔐 .gitignore - منع رفع الملفات الحساسة
# ================================================================

# 🔑 الملفات الحساسة - لا ترفعها أبدا!
keys.js
.env
.env.local
.env.*.local
*.key
*.pem
*.crt
*.p12
secrets.json
config.local.js

# ✅ لكن ارفع النموذج
!keys.example.js

# 📦 Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# 🔧 IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 📁 مؤقتات
temp/
tmp/
*.tmp
*.log
*.cache

# 🗄️ قاعدة بيانات
*.sqlite
*.db
*.sqlite3

# 📦 Build
dist/
build/
*.min.js
*.min.css
*.map

# 🧪 اختبارات
coverage/
.nyc_output/
